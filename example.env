# Public listen addresses (port plan: website block 20010; HTTP +0,
# metrics/pprof +2).
WEBSITE_HTTP_ADDR=:20010
WEBSITE_METRICS_ADDR=:20012

# development | production (production enables Secure cookies).
WEBSITE_ENVIRONMENT=production

# Account core (never its database). HTTP base for /v1/* and gRPC for the
# internal contracts (Identity, Links, Social, Events). Decided defaults:
# account block 20000 — HTTP 20000, gRPC 20001.
CORE_BASE_URL=http://localhost:20000
CORE_GRPC_ADDR=localhost:20001
# Shared internal credential; must match the core's ACCOUNT_INTERNAL_KEY.
CORE_INTERNAL_KEY=change-me-internal-change-me-internal!

# Website-owned Postgres (site config, api tokens, audit, media metadata).
# Port plan: development Postgres on 23000.
WEBSITE_DATABASE_URL=postgres://website:secret@localhost:23000/website

# Required, >=32 bytes. CSRF + bearer-token derivation.
WEBSITE_SESSION_SECRET=change-me-session-secret-32-bytes-min!!

# Account ids allowed to open /admin (fail closed; comma separated).
WEBSITE_ADMIN_ACCOUNT_IDS=

# Filesystem root for avatar storage (S3-compatible backend can replace it;
# see internal/media.Storage).
WEBSITE_MEDIA_DIR=storage/media

# Set to any non-empty value to seed the supported-titles table on first boot.
WEBSITE_SEED_TITLES=

# Network profile (PRD network-profile-service-prd): the read-only mount of
# Traefik's dynamic configuration, which the profile is generated from. Empty
# disables /api/v1/network/* and nothing else on the site changes.
# On the production box the file lives at ~/openpak/deploy/traefik/dynamic.yml.
NETPROFILE_TRAEFIK_FILE=
# Optional override for the embedded per-platform map (internal/netprofile/platforms.yml).
# The embedded copy is what production runs.
NETPROFILE_PLATFORM_MAP=
# Firebase service-account JSON; empty disables notifications.
FCM_CREDENTIALS_FILE=

# Shared secret for POST /internal/avatar (the Switch adapter hands over a
# console's profile picture). Empty disables the route entirely.
WEBSITE_INTERNAL_KEY=

# Admin monitor: the availability page's JSON (status.openpak.org, Gatus-backed),
# read from outside the network. Empty uses the default below; "off" hides it.
STATUS_API_URL=https://status.openpak.org/api/status

# --- The v2 network registry (cmd/openpak-registry, docs/registry.md) ---
# These belong to the REGISTRY container (same image, command /app/openpak-registry),
# never to the website: the website does not read them. Port plan: registry block
# 20140; HTTP +0, metrics/pprof +2.
REGISTRY_HTTP_ADDR=:20140
REGISTRY_METRICS_ADDR=:20142
# All four or none; none answers 503 on /api/v2/network/*.
REGISTRY_DATABASE_URL=
REGISTRY_BLOB_DIR=
REGISTRY_ONLINE_KEY_FILE=
REGISTRY_ROOT_METADATA_FILE=
REGISTRY_POLICY_ID=openpak-production
# Production CI identity (GitHub Actions OIDC). Staging may use the static token instead.
REGISTRY_OIDC_AUDIENCE=
REGISTRY_OIDC_ISSUER=
REGISTRY_STAGING_CI_TOKEN=
REGISTRY_STAGING_CI_REPOSITORY=
# Bearer for GET /internal/status (the website admin page). Empty: the route answers 404.
REGISTRY_ADMIN_KEY=
