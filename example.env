# Public listen addresses (port plan: website block 20010; HTTP +0,
# metrics/pprof +2).
WEBSITE_HTTP_ADDR=:20010
WEBSITE_METRICS_ADDR=:20012

# development | production (production enables Secure cookies).
WEBSITE_ENVIRONMENT=production
# debug also logs every request; anything else (or empty) is info.
WEBSITE_LOG_LEVEL=

# Account core (never its database). HTTP base for /v1/* and gRPC for the
# internal contracts (Identity, Links, Social, Events). Decided defaults:
# account block 20000 — HTTP 20000, gRPC 20001.
CORE_BASE_URL=http://localhost:20000
CORE_GRPC_ADDR=localhost:20001
# Shared internal credential; must match the core's ACCOUNT_INTERNAL_KEY.
CORE_INTERNAL_KEY=change-me-internal-change-me-internal!

# Website-owned Postgres (site config, api tokens, audit, media metadata).
# Port plan: development Postgres on 23000.
WEBSITE_DATABASE_URL=postgres://website:secret@localhost:23000/website

# Required, >=32 bytes. CSRF + bearer-token derivation.
WEBSITE_SESSION_SECRET=change-me-session-secret-32-bytes-min!!

# Account ids allowed to open /admin (fail closed; comma separated).
WEBSITE_ADMIN_ACCOUNT_IDS=

# Filesystem root for avatar storage (S3-compatible backend can replace it;
# see internal/media.Storage).
WEBSITE_MEDIA_DIR=storage/media

# Set to any non-empty value to seed the supported-titles table on first boot.
WEBSITE_SEED_TITLES=
# Live catalog.json refetched and reseeded every CATALOG_REFRESH (Go duration, default
# 10m). The refresh only runs when WEBSITE_SEED_TITLES is set; empty URL disables it.
CATALOG_URL=https://raw.githubusercontent.com/openpak/catalog/main/catalog.json
CATALOG_REFRESH=10m

# Saves service internal API (cloud saves page + /api/v1 saves). Unset URL: the page
# says so and the API answers 503.
SAVES_URL=
SAVES_INTERNAL_KEY=

# Chat service internal API (chat page + /api/v1 chat). Unset URL: same as saves.
CHAT_URL=
CHAT_INTERNAL_KEY=

# Switch adapter internal API (friend code, console link status). The key must match
# the adapter's NX_INTERNAL_KEY. Unset URL: no Switch code is shown.
ADAPTER_INTERNAL_URL=
NX_INTERNAL_KEY=
# Public adapter link page, reverse-proxied at /link and /link/. Empty: not mounted.
ADAPTER_LINK_URL=

# Wii U/3DS adapter (nn-account) internal API, used by the emulator /api/v1/me routes.
# Unset URL: those routes answer 503.
NN_ACCOUNT_INTERNAL_URL=
NN_ACCOUNT_INTERNAL_KEY=

# Wii/DS server (nn-wfc) API for linking a Wii/DS by friend code. Unset URL: the page
# offers no Wii/DS link.
WFC_API_URL=
WFC_API_SECRET=

# Mods service public API, reverse-proxied under /api/v1/titles/, /api/v1/mods/,
# /api/v1/submissions and /api/v1/me/{submissions,favourites}. Empty: not mounted.
MODS_URL=

# Network profile (PRD network-profile-service-prd): the read-only mount of
# Traefik's dynamic configuration, which the profile is generated from. Empty
# disables /api/v1/network/* and nothing else on the site changes.
# On the production box the file lives at ~/openpak/deploy/traefik/dynamic.yml.
NETPROFILE_TRAEFIK_FILE=
# Optional override for the embedded per-platform map (internal/netprofile/platforms.yml).
# The embedded copy is what production runs.
NETPROFILE_PLATFORM_MAP=
# Firebase service-account JSON; empty disables notifications.
FCM_CREDENTIALS_FILE=

# Shared secret for POST /internal/avatar (the Switch adapter hands over a
# console's profile picture). Empty disables the route entirely. The adapter holds
# the same value plus its own WEBSITE_INTERNAL_URL (not read by this binary).
WEBSITE_INTERNAL_KEY=

# /status game-server health probes (internal/pages/gameservers.go). A URL is probed;
# "off" shows "not checked"; empty means the default. The Switch-era NEX titles run in
# switch-nexd on the host network and default to http://host.containers.internal:<base+2>/healthz.
MHGU_HEALTH_URL=http://openpak-monster-hunter-generations-ultimate:22122/healthz
PHOTON_HEALTH_URL=http://openpak-photon:8080/health
SPLATOON3_HEALTH_URL=http://openpak-splatoon-3:21013/health
STARDEW_HEALTH_URL=http://openpak-stardew:21011/health
ACNH_HEALTH_URL=
ARMS_HEALTH_URL=
LM3_HEALTH_URL=
GOLF_HEALTH_URL=
MK8D_HEALTH_URL=
MPS_HEALTH_URL=
STRIKERS_HEALTH_URL=
MTA_HEALTH_URL=
MINECRAFT_HEALTH_URL=
SPLATOON2_HEALTH_URL=
SMB35_HEALTH_URL=
SMM2_HEALTH_URL=
SMO_HEALTH_URL=
SSBU_HEALTH_URL=
SM3DW_HEALTH_URL=
KIRBY_HEALTH_URL=
CLUBHOUSE_HEALTH_URL=

# Admin monitor: the availability page's JSON (status.openpak.org, Gatus-backed),
# read from outside the network. Empty uses the default below; "off" hides it.
STATUS_API_URL=https://status.openpak.org/api/status

# News service (ports.md block 20040). NEWS_URL is its public read API, for the
# latest articles on the landing page (empty: no news section). NEWS_GRPC_ADDR and
# NEWS_OPERATOR_KEY are the operator gRPC behind /admin/news; the key must match the
# news service's NEWS_OPERATOR_KEY. Either unset: /admin/news says "not configured".
NEWS_URL=http://localhost:20040
NEWS_GRPC_ADDR=localhost:20041
NEWS_OPERATOR_KEY=

# Mods service curation API behind /admin/mods (ports.md block 20030). The key must
# match the mods service's MODS_INTERNAL_KEY. Either unset: the page says so.
MODS_INTERNAL_URL=http://localhost:20030
MODS_INTERNAL_KEY=

# Registry service's read-only operator status behind /admin/registry
# (GET /internal/status, bearer REGISTRY_ADMIN_KEY). Either unset: the page says so.
REGISTRY_INTERNAL_URL=
# Same value as the registry container's REGISTRY_ADMIN_KEY below.
REGISTRY_ADMIN_KEY=

# Host agents behind /admin/services (cmd/openpak-opsd, docs/opsd.md): name=url pairs,
# comma-separated, one per host; the key is every agent's OPSD_KEY. Either unset: the
# page says so.
WEBSITE_OPSD_HOSTS=
WEBSITE_OPSD_KEY=

# --- The v2 network registry (cmd/openpak-registry, docs/registry.md) ---
# These belong to the REGISTRY container (same image, command /app/openpak-registry),
# never to the website — except REGISTRY_ADMIN_KEY, which both hold. Port plan: registry block
# 20140; HTTP +0, metrics/pprof +2.
REGISTRY_HTTP_ADDR=:20140
REGISTRY_METRICS_ADDR=:20142
# All four or none; none answers 503 on /api/v2/network/*.
REGISTRY_DATABASE_URL=
REGISTRY_BLOB_DIR=
REGISTRY_ONLINE_KEY_FILE=
REGISTRY_ROOT_METADATA_FILE=
REGISTRY_POLICY_ID=openpak-production
# Production CI identity (GitHub Actions OIDC). Staging may use the static token instead.
REGISTRY_OIDC_AUDIENCE=
REGISTRY_OIDC_ISSUER=
REGISTRY_STAGING_CI_TOKEN=
REGISTRY_STAGING_CI_REPOSITORY=
# Bearer for GET /internal/status (the website admin page). Empty: the route answers 404.
REGISTRY_ADMIN_KEY=
